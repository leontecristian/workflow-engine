{
  "schemaVersion": 1,
  "key": "sequentialReview",
  "version": 1,
  "name": "Sequential manager and partner review",
  "startPolicy": {
    "inputContract": []
  },
  "variables": [],
  "nodes": [
    {
      "key": "BEGIN",
      "type": "START",
      "name": "Begin"
    },
    {
      "key": "MANAGER",
      "type": "HUMAN_TASK",
      "name": "Manager review",
      "taskType": "SANDBOX_REVIEW",
      "assignment": {
        "resolver": "sandbox.singleReviewer",
        "inputs": {}
      },
      "completion": {
        "policy": "SINGLE"
      },
      "resultContract": {
        "mode": "FORBIDDEN"
      },
      "outcomes": [
        {
          "key": "APPROVE",
          "label": "Approve",
          "requiresComment": false
        },
        {
          "key": "REJECT",
          "label": "Reject",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "PARTNER",
      "type": "HUMAN_TASK",
      "name": "Partner review",
      "taskType": "SANDBOX_REVIEW",
      "assignment": {
        "resolver": "sandbox.singleReviewer",
        "inputs": {}
      },
      "completion": {
        "policy": "SINGLE"
      },
      "resultContract": {
        "mode": "FORBIDDEN"
      },
      "outcomes": [
        {
          "key": "APPROVE",
          "label": "Approve",
          "requiresComment": false
        },
        {
          "key": "REJECT",
          "label": "Reject",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "APPROVED",
      "type": "END",
      "name": "Approved",
      "result": "APPROVED"
    },
    {
      "key": "REJECTED",
      "type": "END",
      "name": "Rejected",
      "result": "REJECTED"
    }
  ],
  "transitions": [
    {
      "key": "begin",
      "from": "BEGIN",
      "to": "MANAGER"
    },
    {
      "key": "managerApprove",
      "from": "MANAGER",
      "to": "PARTNER",
      "outcome": "APPROVE"
    },
    {
      "key": "managerReject",
      "from": "MANAGER",
      "to": "REJECTED",
      "outcome": "REJECT"
    },
    {
      "key": "partnerApprove",
      "from": "PARTNER",
      "to": "APPROVED",
      "outcome": "APPROVE"
    },
    {
      "key": "partnerReject",
      "from": "PARTNER",
      "to": "REJECTED",
      "outcome": "REJECT"
    }
  ]
}
