{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/workflow-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    "material-symbols.LICENSE.txt",
    "material-symbols.NOTICE.txt",
    "fonts/material-symbols-outlined.ttf",
    "styles/material-symbols.css",
    {
      "glob": "instance-graph.scss",
      "input": "src/lib/graph",
      "output": "styles"
    }
  ]
}
