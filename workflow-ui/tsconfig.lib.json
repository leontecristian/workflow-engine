{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "declaration": true,
    "inlineSources": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "compilationMode": "partial"
  }
}
